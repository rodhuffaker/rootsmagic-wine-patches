+static void STDMETHODCALLTYPE d2d_device_context_PushAxisAlignedClip(ID2D1DeviceContext6 *iface,
+        const D2D1_RECT_F *clip_rect, D2D1_ANTIALIAS_MODE antialias_mode);
+
+/* FireMonkey uses a layer containing several dirty rectangles. Keeping only
+ * its bounds also repaints the clean gaps, without repainting their controls.
+ * Preserve rectangular masks as a non-overlapping region. Other masks retain
+ * the existing bounding-box approximation until full layer support exists. */
+struct fmx_rect_sink
+{
+    ID2D1SimplifiedGeometrySink ID2D1SimplifiedGeometrySink_iface;
+    D2D1_POINT_2F figure[5];
+    unsigned int vertex_count, figure_count;
+    POINT *points;
+    size_t capacity;
+    D2D1_MATRIX_3X2_F transform;
+    float dpi_x, dpi_y;
+    int fill_mode;
+    BOOL valid;
+};
+
+static struct fmx_rect_sink *fmx_sink_impl(ID2D1SimplifiedGeometrySink *iface)
+{
+    return CONTAINING_RECORD(iface, struct fmx_rect_sink, ID2D1SimplifiedGeometrySink_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE fmx_sink_QueryInterface(ID2D1SimplifiedGeometrySink *iface, REFIID iid, void **out)
+{
+    *out = NULL;
+    if (!IsEqualGUID(iid, &IID_IUnknown) && !IsEqualGUID(iid, &IID_ID2D1SimplifiedGeometrySink))
+        return E_NOINTERFACE;
+    *out = iface;
+    return S_OK;
+}
+static ULONG STDMETHODCALLTYPE fmx_sink_AddRef(ID2D1SimplifiedGeometrySink *iface) { return 2; }
+static ULONG STDMETHODCALLTYPE fmx_sink_Release(ID2D1SimplifiedGeometrySink *iface) { return 1; }
+static void STDMETHODCALLTYPE fmx_sink_SetFillMode(ID2D1SimplifiedGeometrySink *iface, D2D1_FILL_MODE mode)
+{
+    fmx_sink_impl(iface)->fill_mode = mode == D2D1_FILL_MODE_WINDING ? WINDING : ALTERNATE;
+}
+static void STDMETHODCALLTYPE fmx_sink_SetSegmentFlags(ID2D1SimplifiedGeometrySink *iface, D2D1_PATH_SEGMENT flags) {}
+static void fmx_sink_point(struct fmx_rect_sink *sink, D2D1_POINT_2F point)
+{
+    D2D1_POINT_2F *p;
+    if (sink->vertex_count >= ARRAY_SIZE(sink->figure)) { sink->valid = FALSE; return; }
+    p = &sink->figure[sink->vertex_count++];
+    d2d_point_transform(p, &sink->transform, point.x, point.y);
+    p->x *= sink->dpi_x;
+    p->y *= sink->dpi_y;
+    if (!isfinite(p->x) || !isfinite(p->y) || fabsf(p->x) > 1000000.0f || fabsf(p->y) > 1000000.0f)
+        sink->valid = FALSE;
+}
+static void STDMETHODCALLTYPE fmx_sink_BeginFigure(ID2D1SimplifiedGeometrySink *iface,
+        D2D1_POINT_2F start, D2D1_FIGURE_BEGIN begin)
+{
+    struct fmx_rect_sink *sink = fmx_sink_impl(iface);
+    sink->vertex_count = 0;
+    if (begin != D2D1_FIGURE_BEGIN_FILLED) sink->valid = FALSE;
+    fmx_sink_point(sink, start);
+}
+static void STDMETHODCALLTYPE fmx_sink_AddLines(ID2D1SimplifiedGeometrySink *iface,
+        const D2D1_POINT_2F *points, UINT count)
+{
+    struct fmx_rect_sink *sink = fmx_sink_impl(iface);
+    unsigned int i;
+    for (i = 0; i < count && sink->valid; ++i) fmx_sink_point(sink, points[i]);
+}
+static void STDMETHODCALLTYPE fmx_sink_AddBeziers(ID2D1SimplifiedGeometrySink *iface,
+        const D2D1_BEZIER_SEGMENT *curves, UINT count)
+{
+    fmx_sink_impl(iface)->valid = FALSE;
+}
+static void STDMETHODCALLTYPE fmx_sink_EndFigure(ID2D1SimplifiedGeometrySink *iface, D2D1_FIGURE_END end)
+{
+    struct fmx_rect_sink *sink = fmx_sink_impl(iface);
+    unsigned int i;
+    if (!sink->valid) return;
+    if (sink->vertex_count == 5 && sink->figure[4].x == sink->figure[0].x
+            && sink->figure[4].y == sink->figure[0].y) --sink->vertex_count;
+    if (end != D2D1_FIGURE_END_CLOSED || sink->vertex_count != 4) { sink->valid = FALSE; return; }
+    for (i = 0; i < 4; ++i)
+    {
+        D2D1_POINT_2F a = sink->figure[i], b = sink->figure[(i + 1) % 4];
+        if (a.x != b.x && a.y != b.y) { sink->valid = FALSE; return; }
+    }
+    if (!d2d_array_reserve((void **)&sink->points, &sink->capacity,
+            (sink->figure_count + 1) * 4, sizeof(*sink->points))) { sink->valid = FALSE; return; }
+    for (i = 0; i < 4; ++i)
+    {
+        sink->points[sink->figure_count * 4 + i].x = ceilf(sink->figure[i].x - 0.5f);
+        sink->points[sink->figure_count * 4 + i].y = ceilf(sink->figure[i].y - 0.5f);
+    }
+    ++sink->figure_count;
+}
+static HRESULT STDMETHODCALLTYPE fmx_sink_Close(ID2D1SimplifiedGeometrySink *iface) { return S_OK; }
+static const ID2D1SimplifiedGeometrySinkVtbl fmx_rect_sink_vtbl =
+{
+    fmx_sink_QueryInterface, fmx_sink_AddRef, fmx_sink_Release,
+    fmx_sink_SetFillMode, fmx_sink_SetSegmentFlags, fmx_sink_BeginFigure,
+    fmx_sink_AddLines, fmx_sink_AddBeziers, fmx_sink_EndFigure, fmx_sink_Close,
+};
+
+static void fmx_push_rect_region(struct d2d_device_context *context, const D2D1_LAYER_PARAMETERS *p)
+{
+    struct d2d_clip_stack *stack = &context->clip_stack;
+    struct fmx_rect_sink sink = {0};
+    struct d2d_clip_region *region;
+    DWORD size;
+    HRESULT hr;
+    int *counts;
+    unsigned int i;
+    HRGN handle;
+
+    if (!p->geometricMask) return;
+    sink.ID2D1SimplifiedGeometrySink_iface.lpVtbl = &fmx_rect_sink_vtbl;
+    sink.transform = context->drawing_state.transform;
+    sink.dpi_x = context->desc.dpiX / 96.0f;
+    sink.dpi_y = context->desc.dpiY / 96.0f;
+    sink.fill_mode = ALTERNATE;
+    sink.valid = TRUE;
+    hr = ID2D1Geometry_Simplify(p->geometricMask, D2D1_GEOMETRY_SIMPLIFICATION_OPTION_CUBICS_AND_LINES,
+            &p->maskTransform, D2D1_DEFAULT_FLATTENING_TOLERANCE, &sink.ID2D1SimplifiedGeometrySink_iface);
+    if (FAILED(hr) || !sink.valid || !sink.figure_count) { free(sink.points); return; }
+    if (!(counts = malloc(sink.figure_count * sizeof(*counts)))) { free(sink.points); return; }
+    for (i = 0; i < sink.figure_count; ++i) counts[i] = 4;
+    handle = CreatePolyPolygonRgn(sink.points, counts, sink.figure_count, sink.fill_mode);
+    free(counts);
+    free(sink.points);
+    if (!handle) return;
+    if (stack->regions && CombineRgn(handle, handle, stack->regions->handle, RGN_AND) == ERROR)
+    { DeleteObject(handle); return; }
+    size = GetRegionData(handle, 0, NULL);
+    if (!size || !(region = malloc(sizeof(*region)))) { DeleteObject(handle); return; }
+    if (!(region->data = malloc(size))) { free(region); DeleteObject(handle); return; }
+    if (!GetRegionData(handle, size, region->data))
+    { free(region->data); free(region); DeleteObject(handle); return; }
+    region->handle = handle;
+    region->depth = stack->count;
+    region->previous = stack->regions;
+    stack->regions = region;
+    TRACE("FMX_RECT_MASK figures %u rectangles %lu depth %u.\n", sink.figure_count,
+            region->data->rdh.nCount, (unsigned int)region->depth);
+}
+
+static void fmx_push_layer_clip(ID2D1DeviceContext6 *iface, const D2D1_LAYER_PARAMETERS *p)
+{
+    D2D1_RECT_F bounds = p->contentBounds, mask;
+    HRESULT hr;
+
+    if (p->geometricMask)
+    {
+        hr = ID2D1Geometry_GetBounds(p->geometricMask, &p->maskTransform, &mask);
+        if (SUCCEEDED(hr))
+        {
+            bounds.left = max(bounds.left, mask.left);
+            bounds.top = max(bounds.top, mask.top);
+            bounds.right = min(bounds.right, mask.right);
+            bounds.bottom = min(bounds.bottom, mask.bottom);
+        }
+        else WARN("FMX_LAYER mask bounds failed %#lx.\n", hr);
+    }
+    /* Avoid overflow when transforming the API's infinite content bounds. */
+    bounds.left = max(bounds.left, -1000000.0f);
+    bounds.top = max(bounds.top, -1000000.0f);
+    bounds.right = min(bounds.right, 1000000.0f);
+    bounds.bottom = min(bounds.bottom, 1000000.0f);
+    if (bounds.right < bounds.left || bounds.bottom < bounds.top)
+        bounds.left = bounds.top = bounds.right = bounds.bottom = 0.0f;
+    WARN("FMX_LAYER_CLIP %s opacity %.3f brush %p.\n", debug_d2d_rect_f(&bounds), p->opacity, p->opacityBrush);
+    d2d_device_context_PushAxisAlignedClip(iface, &bounds, D2D1_ANTIALIAS_MODE_ALIASED);
+    fmx_push_rect_region(impl_from_ID2D1DeviceContext(iface), p);
+}
