+            reg_x0 = max(0.0f, fmx_probe_region.left * sx);
+            reg_y0 = max(0.0f, fmx_probe_region.top * sy);
+            reg_x1 = min((float)desc.Width, fmx_probe_region.right * sx);
+            reg_y1 = min((float)desc.Height, fmx_probe_region.bottom * sy);
+            for (y = reg_y0; y < reg_y1; ++y)
