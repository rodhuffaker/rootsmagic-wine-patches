+                    ++full_nonzero;
+                    full_opaque += p[3] == 0xff;
+                    full_rgb += !!(p[0] || p[1] || p[2]);
+                    bb_x0 = min(bb_x0, x); bb_y0 = min(bb_y0, y);
+                    bb_x1 = max(bb_x1, x); bb_y1 = max(bb_y1, y);
+                }
+        }
