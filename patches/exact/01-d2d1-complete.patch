+    /* Per-draw probes ("after-*") are only useful, and only affordable, on
+     * popup-sized targets; skip the full-window and tiny icon targets. */
+    if (!strncmp(operation, "after-draw", 10) || !strncmp(operation, "after-fill", 10))
+    {
