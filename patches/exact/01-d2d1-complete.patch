+        WARN("FMX_PROBE_VIEWS %s bitmap %p resource %p rtv %p rtv_resource %p srv %p options %#x size %ux%u.\n",
+                operation, bitmap, bitmap->resource, bitmap->rtv, rtv_res, bitmap->srv, bitmap->options,
+                bitmap->pixel_size.width, bitmap->pixel_size.height);
+        if (rtv_res)
+            ID3D11Resource_Release(rtv_res);
+    }
+    WARN("FMX_PROBE %s ctx %p resource %p size %ux%u format %u clips %u hr %#lx lit %u/%u mean %.2f alpha0 %u alpha255 %u top_clip %s transform %s.\n",
+            operation, ctx, bitmap->resource, desc.Width, desc.Height, desc.Format,
+            ctx->clip_stack.count, hr, lit, count, count ? (double)sum / (3 * count) : 0.0,
+            alpha_zero, alpha_full,
+            ctx->clip_stack.count ? debug_d2d_rect_f(&ctx->clip_stack.stack[ctx->clip_stack.count - 1]) : "none",
+            debug_d2d_matrix_3x2_f(&ctx->drawing_state.transform));
+    ID3D11DeviceContext_Release(dc);
+    ID3D11Texture2D_Release(copy);
+    ID3D11Texture2D_Release(source);
+}
