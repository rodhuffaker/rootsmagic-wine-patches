+    }
+    if (desc.Width <= 1200 || !strncmp(operation, "src-", 4))
+        WARN("FMX_PROBE_FULL %s ctx %p size %ux%u alpha>0 %u opaque %u nonblack %u bbox (%u,%u)-(%u,%u).\n",
+                operation, ctx, desc.Width, desc.Height, full_nonzero, full_opaque, full_rgb,
+                bb_x0, bb_y0, bb_x1, bb_y1);
+    if (fmx_probe_region_set)
+        WARN("FMX_PROBE_REGION %s bitmap %p region_px %u (%u,%u)-(%u,%u) alpha>0 %u opaque %u nonblack %u dpi %.1f.\n",
+                operation, bitmap, reg_px, reg_x0, reg_y0, reg_x1, reg_y1, reg_alpha, reg_opaque, reg_nonblack,
+                bitmap->dpi_x);
+    {
+        ID3D11Resource *rtv_res = NULL;
+
+        if (bitmap->rtv)
