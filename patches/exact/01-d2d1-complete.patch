+static HRESULT d2d_device_context_get_scratch_buffer(struct d2d_device_context *render_target,
+        enum d2d_scratch_buffer slot_id, UINT bind_flags, const void *data, UINT size, ID3D11Buffer **buffer)
+{
+    struct d2d_scratch_buffer_slot *slot = &render_target->scratch_buffers[slot_id];
+    D3D11_MAPPED_SUBRESOURCE map_desc;
+    ID3D11DeviceContext *d3d_context;
+    HRESULT hr;
+
+    if (fmx_d2d_pooling_disabled())
+    {
+        D3D11_BUFFER_DESC buffer_desc = {0};
+        D3D11_SUBRESOURCE_DATA buffer_data = {0};
+
+        buffer_desc.ByteWidth = size;
+        buffer_desc.Usage = D3D11_USAGE_DEFAULT;
+        buffer_desc.BindFlags = bind_flags;
+        buffer_data.pSysMem = data;
+        return ID3D11Device1_CreateBuffer(render_target->d3d_device, &buffer_desc, &buffer_data, buffer);
+    }
+
+    if (!slot->buffer || slot->size < size)
+    {
+        D3D11_BUFFER_DESC buffer_desc;
+        UINT new_size = max(size, slot->size + slot->size / 2);
+
+        if (slot->buffer)
+        {
+            ID3D11Buffer_Release(slot->buffer);
+            slot->buffer = NULL;
+            slot->size = 0;
+        }
+
+        buffer_desc.ByteWidth = new_size;
+        buffer_desc.Usage = D3D11_USAGE_DYNAMIC;
+        buffer_desc.BindFlags = bind_flags;
+        buffer_desc.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
+        buffer_desc.MiscFlags = 0;
+        buffer_desc.StructureByteStride = 0;
+
+        if (FAILED(hr = ID3D11Device1_CreateBuffer(render_target->d3d_device, &buffer_desc, NULL, &slot->buffer)))
+        {
+            WARN("Failed to create scratch buffer, hr %#lx.\n", hr);
+            return hr;
+        }
+        slot->size = new_size;
+    }
+
+    ID3D11Device1_GetImmediateContext(render_target->d3d_device, &d3d_context);
+    if (FAILED(hr = ID3D11DeviceContext_Map(d3d_context, (ID3D11Resource *)slot->buffer,
+            0, D3D11_MAP_WRITE_DISCARD, 0, &map_desc)))
+    {
+        WARN("Failed to map scratch buffer, hr %#lx.\n", hr);
+        ID3D11DeviceContext_Release(d3d_context);
+        return hr;
+    }
+    memcpy(map_desc.pData, data, size);
+    ID3D11DeviceContext_Unmap(d3d_context, (ID3D11Resource *)slot->buffer, 0);
+    ID3D11DeviceContext_Release(d3d_context);
+
+    ID3D11Buffer_AddRef(slot->buffer);
+    *buffer = slot->buffer;
+    return S_OK;
+}
