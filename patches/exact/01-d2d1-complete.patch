+                lit += !!(p[0] || p[1] || p[2]);
+                alpha_zero += !p[3];
+                alpha_full += p[3] == 0xff;
+                ++count;
+            }
+        if (fmx_probe_region_set)
+        {
+            float sx = bitmap->dpi_x ? bitmap->dpi_x / 96.0f : 1.0f, sy = bitmap->dpi_y ? bitmap->dpi_y / 96.0f : 1.0f;
