+    ID3D11DeviceContext_CopyResource(dc, (ID3D11Resource *)copy, (ID3D11Resource *)source);
+    hr = ID3D11DeviceContext_Map(dc, (ID3D11Resource *)copy, 0, D3D11_MAP_READ, 0, &map);
+    if (SUCCEEDED(hr))
