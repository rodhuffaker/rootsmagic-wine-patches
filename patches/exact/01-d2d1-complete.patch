+    unsigned int full_nonzero = 0, full_opaque = 0, full_rgb = 0, bb_x0 = ~0u, bb_y0 = ~0u, bb_x1 = 0, bb_y1 = 0;
+    unsigned long long sum = 0;
+    char enabled[8];
+    HRESULT hr;
