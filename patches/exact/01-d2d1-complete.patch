+static void fmx_probe_bitmap(struct d2d_device_context *ctx, struct d2d_bitmap *bitmap, const char *operation)
+{
+    unsigned int reg_px = 0, reg_alpha = 0, reg_opaque = 0, reg_nonblack = 0;
+    unsigned int reg_x0 = 0, reg_y0 = 0, reg_x1 = 0, reg_y1 = 0;
+    ID3D11Texture2D *source, *copy;
+    ID3D11DeviceContext *dc;
+    D3D11_TEXTURE2D_DESC desc;
+    D3D11_MAPPED_SUBRESOURCE map;
