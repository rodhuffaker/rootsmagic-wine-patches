+static const WCHAR fmx_window_property[] = L"RootsMagic.DXGI.FrameState";
+/* FireMonkey can dispatch a paint mid-way through switching tabs, before the
+ * old tab's panel has been hidden, producing one frame that composites both
+ * the old and new view (see FAMILY-VIEW-AUDIT.md, 2026-09-17). Rather than
+ * blit every backbuffer readback to the screen immediately, debounce: wait
+ * for a quiet period after the last Present() before actually presenting,
+ * so a burst of rapid frames only ever shows its last (settled) one. A lone,
+ * non-bursty frame still gets a short delay to catch back-to-back frames,
+ * but nothing worth calling "input lag".
+ *
+ * Some content (e.g. the tab bar) turned out not to be stale-content overlap
+ * but FireMonkey's own layout not finishing synchronously with the paint,
+ * only completing as the app's message loop keeps getting pumped (2026-09-17
+ * live validation). Two rounds of actively nudging the app with synthetic
+ * WM_MOUSEMOVE deltas (single, then chained up to 4x) were both tried and
+ * measured live: neither helped (44 of 45 chained-nudge attempts exhausted
+ * the whole 4-attempt budget without ever producing a new frame, and the
+ * stale-content rate didn't improve). Injecting synthetic messages may
+ * simply be competing with whatever the app's own idle-triggered completion
+ * logic needs, rather than helping it. So instead of nudging, this now just
+ * waits passively for a longer quiet period -- FMX_GDI_PRESENT_BURST_MS was
+ * 80ms; not yet validated whether a longer wait actually helps completion,
+ * this is the next thing to measure. */
+#define FMX_GDI_PRESENT_TIMER 0xF3A9
+#define FMX_GDI_PRESENT_DEBOUNCE_BURST_MS 300
+#define FMX_GDI_PRESENT_DEBOUNCE_IDLE_MS 16
+#define FMX_GDI_PRESENT_BURST_WINDOW_MS 150
+
+static void WINAPI fmx_staging_destroyed(void *parent)
+{
+}
+
+static const struct wined3d_parent_ops fmx_staging_parent_ops = {fmx_staging_destroyed};
+
+static BOOL fmx_gdi_present_enabled(void)
+{
+    char value[8];
+
+    return GetEnvironmentVariableA("ROOTSMAGIC_GDI_PRESENT", value, sizeof(value))
+            && value[0] && value[0] != '0';
+}
+
+static BOOL fmx_gdi_repaint_enabled(void)
+{
+    char value[8];
+
+    return GetEnvironmentVariableA("ROOTSMAGIC_GDI_REPAINT", value, sizeof(value))
+            && value[0] && value[0] != '0';
+}
+
+static void fmx_gdi_present(HWND hwnd, unsigned int source_width, unsigned int source_height,
+        const void *pixels)
+{
+    BITMAPINFO bmi = {0};
+    RECT client_rect;
+    HDC dc;
+    int width, height;
+
+    if (!hwnd || !IsWindowVisible(hwnd) || IsIconic(hwnd))
+        return;
+    if (!GetClientRect(hwnd, &client_rect))
+    {
+        WARN("Failed to get target window client rect.\n");
+        return;
+    }
+
+    width = client_rect.right - client_rect.left;
+    height = client_rect.bottom - client_rect.top;
+    if (width <= 1 || height <= 1)
+        return;
+
+    bmi.bmiHeader.biSize = sizeof(bmi.bmiHeader);
+    bmi.bmiHeader.biWidth = source_width;
+    bmi.bmiHeader.biHeight = -(LONG)source_height;
+    bmi.bmiHeader.biPlanes = 1;
+    bmi.bmiHeader.biBitCount = 32;
+    bmi.bmiHeader.biCompression = BI_RGB;
+
+    if (!(dc = GetDC(hwnd)))
+    {
+        WARN("Failed to get target window DC.\n");
+        return;
+    }
+
+    SetStretchBltMode(dc, COLORONCOLOR);
+    if (StretchDIBits(dc, 0, 0, width, height, 0, 0, source_width, source_height,
+            pixels, &bmi, DIB_RGB_COLORS, SRCCOPY) == GDI_ERROR)
+        WARN("GDI presentation blit failed.\n");
+    else
+        TRACE("FMX_GDI_PRESENT hwnd %p source %ux%u destination %dx%d.\n",
+                hwnd, source_width, source_height, width, height);
+
+    ReleaseDC(hwnd, dc);
+}
+
+static LRESULT CALLBACK fmx_gdi_wndproc(HWND hwnd, UINT message, WPARAM wparam, LPARAM lparam)
+{
+    LRESULT result;
+    struct fmx_window *state = GetPropW(hwnd, fmx_window_property);
+
+    if (!state)
+        return DefWindowProcW(hwnd, message, wparam, lparam);
+    ++state->callbacks;
+    result = CallWindowProcW(state->original_proc, hwnd, message, wparam, lparam);
+
+    if (message == WM_PAINT && !state->destroyed && !state->painting && state->frame
+            && fmx_gdi_present_enabled() && fmx_gdi_repaint_enabled())
+    {
+        state->painting = TRUE;
+        fmx_gdi_present(hwnd, state->width, state->height, state->frame);
+        state->painting = FALSE;
+        TRACE("FMX_GDI_REPAINT hwnd %p size %ux%u.\n", hwnd, state->width, state->height);
+    }
+    if (message == WM_TIMER && wparam == FMX_GDI_PRESENT_TIMER)
+    {
+        KillTimer(hwnd, FMX_GDI_PRESENT_TIMER);
+        if (state->present_pending && !state->destroyed && !state->painting && state->frame)
+        {
+            state->present_pending = FALSE;
+            state->painting = TRUE;
+            fmx_gdi_present(hwnd, state->width, state->height, state->frame);
+            state->painting = FALSE;
+            TRACE("FMX_GDI_PRESENT_SETTLED hwnd %p size %ux%u.\n", hwnd, state->width, state->height);
+        }
+        else
+            state->present_pending = FALSE;
+    }
+    if (message == WM_NCDESTROY)
+    {
+        if (state->present_pending)
+            KillTimer(hwnd, FMX_GDI_PRESENT_TIMER);
+        if ((WNDPROC)GetWindowLongPtrW(hwnd, GWLP_WNDPROC) == fmx_gdi_wndproc)
+            SetWindowLongPtrW(hwnd, GWLP_WNDPROC, (LONG_PTR)state->original_proc);
+        RemovePropW(hwnd, fmx_window_property);
+        state->destroyed = TRUE;
+        TRACE("FMX_GDI_DESTROY hwnd %p.\n", hwnd);
+    }
+    if (!--state->callbacks && state->destroyed)
+    {
+        HeapFree(GetProcessHeap(), 0, state->frame);
+        HeapFree(GetProcessHeap(), 0, state);
+    }
+
+    return result;
+}
+
+static struct fmx_window *fmx_gdi_install_wndproc(HWND hwnd)
+{
+    struct fmx_window *state;
+    if (!hwnd || GetWindowThreadProcessId(hwnd, NULL) != GetCurrentThreadId())
+        return NULL;
+    if ((state = GetPropW(hwnd, fmx_window_property)))
+        return state;
+    if (!(state = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*state))))
+        return NULL;
+    if (!SetPropW(hwnd, fmx_window_property, state))
+    {
+        HeapFree(GetProcessHeap(), 0, state);
+        return NULL;
+    }
+
+    state->original_proc = (WNDPROC)SetWindowLongPtrW(hwnd, GWLP_WNDPROC,
+            (LONG_PTR)fmx_gdi_wndproc);
+    if (!state->original_proc)
+    {
+        RemovePropW(hwnd, fmx_window_property);
+        HeapFree(GetProcessHeap(), 0, state);
+        WARN("Failed to install GDI repaint window procedure for hwnd %p.\n", hwnd);
+        return NULL;
+    }
+    TRACE("FMX_GDI_SUBCLASS hwnd %p original %p.\n", hwnd, state->original_proc);
+    return state;
+}
+
+static BOOL fmx_gdi_store_frame(struct fmx_window *state, const struct wined3d_sub_resource_desc *desc,
+        const struct wined3d_map_desc *map_desc)
+{
+    SIZE_T row_size = (SIZE_T)desc->width * 4;
+    SIZE_T size = row_size * desc->height;
+    unsigned int y;
+
+    if (state->frame_size != size)
+    {
+        BYTE *frame = state->frame ? HeapReAlloc(GetProcessHeap(), 0, state->frame, size)
+                : HeapAlloc(GetProcessHeap(), 0, size);
+        if (!frame)
+            return FALSE;
+        state->frame = frame;
+        state->frame_size = size;
+    }
+
+    for (y = 0; y < desc->height; ++y)
+        memcpy(state->frame + y * row_size,
+                (const BYTE *)map_desc->data + y * map_desc->row_pitch, row_size);
+
+    state->width = desc->width;
+    state->height = desc->height;
+    return TRUE;
+}
 
