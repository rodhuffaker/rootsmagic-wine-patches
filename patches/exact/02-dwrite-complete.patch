+            "Single character geometry differs.\n");
+    hr = IDWriteTextLayout_HitTestTextRange(layout, 9, 1, 17, 23, shifted, 1, &count2);
+    ok(hr == S_OK && count2 == count, "Offset hr %#lx count %u.\n", hr, count2);
